# Files Docker leaves out when it copies the project into the image (COPY . .).
# Secrets: never bake them into an image; anyone with the image could read them.
.env
.env.*
!.env.example

# Local environment and caches: the image installs its own packages
.venv/
__pycache__/
*.pyc
.pytest_cache/

# Not needed to run the app
.git/
.github/
tests/
*.md
.vscode/
.idea/
